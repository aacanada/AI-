 "total": 49.36,
 "cues": [
  {
   "text": "그래서 AA Canada가 추천하는",
   "start": 0.33,
   "end": 2.83
  },
  {
   "text": "밴쿠버 자녀무상교육 플랜은 두 가지입니다.",
   "start": 2.83,
   "end": 5.33
  },
  {
   "text": "플랜 A.",
   "start": 5.33,
   "end": 5.91
  },
  {
   "text": "영어 점수가 있다면,",
   "start": 5.91,
   "end": 7.43
  },
  {
   "text": "듀오링고 90이나 아이엘츠 5.0부터",
   "start": 7.43,
   "end": 10.61
  },
  {
   "text": "알렉산더 준학사로 바로 입학하는 방법이에요.",
   "start": 10.61,
   "end": 14.11
  },
  {
   "text": "학위 과정이니까 처음부터 자녀",
   "start": 14.11,
   "end": 16.87
  },
  {
   "text": "학비 면제 조건에 들어갑니다.",
   "start": 16.87,
   "end": 19.21
  },
  {
   "text": "플랜 B.",
   "start": 19.21,
   "end": 19.77
  },
  {
   "text": "영어 점수가 없다면,",
   "start": 19.77,
   "end": 21.37
  },
  {
   "text": "알렉산더 조건부 입학허가를 받고 협약",
   "start": 21.37,
   "end": 24.51
  },
  {
   "text": "어학원에서 어학연수로 시작합니다.",
   "start": 24.51,
   "end": 27.41
  },
  {
   "text": "어학연수 최대 1년 동안 자녀 무상교육,",
   "start": 27.41,
   "end": 30.67
  },
  {
   "text": "그다음 준학사로 올라가서 계속 무상교육.",
   "start": 30.67,
   "end": 33.65
  },
  {
   "text": "부모님은 영어를 준비하고,",
   "start": 33.65,
   "end": 35.61
  },
  {
   "text": "아이는 처음부터 공립학교에 다니는 구조예요.",
   "start": 35.61,
   "end": 38.91
  },
  {
   "text": "참고로 밴쿠버 교육청 국제학생 학비는",
   "start": 38.91,
   "end": 42.09
  },
  {
   "text": "2027-28학년도 기준 1년에 17,000달러,",
   "start": 42.09,
   "end": 46.13
  },
  {
   "text": "의료보험 1,400달러가 따로 붙습니다.",
   "start": 46.13,
   "end": 48.01
  }
 ]
