 ],
 "cues": [
  {
   "scene": "s01",
   "text": "밴쿠버 자녀무상교육,",
   "start": 0.74,
   "end": 1.96
  },
  {
   "scene": "s01",
   "text": "영어 점수가 없으면 못 한다고 생각하셨나요?",
   "start": 2.56,
   "end": 4.92
  },
  {
   "scene": "s01",
   "text": "이제는 영어 점수가 없어도,",
   "start": 5.58,
   "end": 7.8
  },
  {
   "scene": "s01",
   "text": "사설 어학원 어학연수로 시작해서 최대 1년까지",
   "start": 7.8,
   "end": 11.48
  },
  {
   "scene": "s01",
   "text": "아이 학비 면제를 받을 수 있는 길이 있습니다.",
   "start": 11.48,
   "end": 13.62
  },
  {
   "scene": "s01",
   "text": "말로만 하면 믿기 어려우시니까,",
   "start": 14.44,
   "end": 16.5
  },
  {
   "scene": "s01",
   "text": "오늘은 BC 주정부 규정 원문을",
   "start": 16.5,
   "end": 19.08
  },
  {
   "scene": "s01",
   "text": "화면에 띄워 놓고 하나씩 보여드릴게요.",
   "start": 19.08,
   "end": 21.26
  },
  {
   "scene": "s01",
   "text": "안녕하세요, AA Canada입니다.",
   "start": 21.94,
   "end": 23.82
  },
  {
   "scene": "s02",
   "text": "먼저 원리부터 짚고 갈게요.",
   "start": 25.644,
   "end": 27.404
  },
  {
   "scene": "s02",
   "text": "BC주에서 아이가 공립학교를 무료로 다니려면,",
   "start": 28.084,
   "end": 31.884
  },
  {
   "scene": "s02",
   "text": "아이가 거주자로 인정돼야 합니다.",
   "start": 31.884,
   "end": 33.924
  },
  {
   "scene": "s02",
   "text": "시민권자나 영주권자가 아니어도,",
   "start": 34.664,
   "end": 37.384
  },
  {
   "scene": "s02",
   "text": "부모가 일정 조건의 학생비자나 취업비자를",
   "start": 37.384,
   "end": 40.464
  },
  {
   "scene": "s02",
   "text": "갖고 있으면 교육청이 학비를 받지 않아요.",
   "start": 40.464,
   "end": 43.024
  },
  {
   "scene": "s02",
   "text": "이 기준을 정해 둔 게 BC주 교육부의",
   "start": 43.684,
   "end": 46.604
  },
  {
   "scene": "s02",
   "text": "운영 지원금 대상 학생 규정입니다.",
   "start": 46.604,
   "end": 48.864
  },
  {
   "scene": "s02",
   "text": "2011년에 시행되고 2013년에 개정된 뒤,",
   "start": 49.564,
   "end": 53.404
  },
  {
   "scene": "s02",
   "text": "지금도 유효한 규정이에요.",
   "start": 53.404,
   "end": 54.904
  },
  {
   "scene": "s03",
   "text": "부모가 학생일 때 기본 조건은 두 가지입니다.",
   "start": 56.633,
   "end": 59.573
  },
  {
   "scene": "s03",
   "text": "첫째, 1년 이상 학업이 허가된 학생비자.",
   "start": 60.193,
   "end": 63.453
  },
  {
   "scene": "s03",
   "text": "둘째, BC주 공립 대학이나 컬리지의 학위·디플로마 과정,",
   "start": 64.213,
   "end": 69.233
  },
  {
   "scene": "s03",
   "text": "또는 사립이라면 학위 과정에 다니고 있어야 해요.",
   "start": 69.233,
   "end": 72.213
  },
  {
   "scene": "s03",
   "text": "여기서 중요한 단어가 '사립은 학위'입니다.",
   "start": 72.933,
   "end": 75.973
  },
  {
   "scene": "s03",
   "text": "사립 컬리지의 디플로마나",
   "start": 76.693,
   "end": 78.293
  },
  {
   "scene": "s03",
   "text": "수료증 과정은 해당이 안 되고,",
   "start": 78.293,
   "end": 80.653
  },
  {
   "scene": "s03",
   "text": "학위 과정이어야 합니다.",
   "start": 80.653,
   "end": 82.293
  },
  {
   "scene": "s03",
   "text": "그래서 저희가 주목하는 게 사립 컬리지의 준학사,",
   "start": 82.293,
   "end": 85.593
  },
  {
   "scene": "s03",
   "text": "어소시에이트 디그리예요.",
   "start": 85.593,
   "end": 87.373
  },
  {
   "scene": "s04",
   "text": "그럼 영어 점수가 없는 부모님은요?",
   "start": 89.099,
   "end": 91.539
  },
  {
   "scene": "s04",
   "text": "바로 이 부분이 오늘의 핵심입니다.",
   "start": 92.299,
   "end": 94.259
  },
  {
   "scene": "s04",
   "text": "규정 바로 아래에 이런 조항이 있어요.",
   "start": 94.939,
   "end": 97.159
  },
  {
   "scene": "s04",
   "text": "1년 이상 학업이 허가된 부모가,",
   "start": 97.959,
   "end": 100.339
  },
  {
   "scene": "s04",
   "text": "다음 세 가지를 모두 충족하면 됩니다.",
   "start": 100.339,
   "end": 102.699
  },
  {
   "scene": "s04",
   "text": "하나, EQA,",
   "start": 103.379,
   "end": 105.379
  },
  {
   "scene": "s04",
   "text": "그러니까 BC주 교육품질인증을 받은 기관에서",
   "start": 105.379,
   "end": 109.399
  },
  {
   "scene": "s04",
   "text": "최대 1년짜리 영어 과정을 듣고 있을 것.",
   "start": 109.399,
   "end": 111.839
  },
  {
   "scene": "s04",
   "text": "둘, 공립 학위나 디플로마,",
   "start": 112.639,
   "end": 115.159
  },
  {
   "scene": "s04",
   "text": "또는 사립 학위 과정에 입학허가를 받았을 것.",
   "start": 115.159,
   "end": 118.079
  },
  {
   "scene": "s04",
   "text": "셋, 그 입학허가가 영어 과정 수료를",
   "start": 118.999,
   "end": 121.999
  },
  {
   "scene": "s04",
   "text": "조건으로 한 조건부 입학일 것.",
   "start": 121.999,
   "end": 123.939
  },
  {
   "scene": "s04",
   "text": "이 세 가지가 맞으면,",
   "start": 124.699,
   "end": 126.259
  },
  {
   "scene": "s04",
   "text": "부모가 어학연수를 하는 동안에도",
   "start": 126.259,
   "end": 128.719
  },
  {
   "scene": "s04",
   "text": "최대 1년까지 거주자로 봅니다.",
   "start": 128.719,
   "end": 130.759
  },
  {
   "scene": "s04",
   "text": "규정에는 '대학 부설'이라는 제한이 없고,",
   "start": 131.519,
   "end": 134.699
  },
  {
   "scene": "s04",
   "text": "EQA 지정 기관이라고만 되어 있어요.",
   "start": 134.699,
   "end": 137.699
  },
  {
   "scene": "s04",
   "text": "그래서 EQA 인증을 받은 사설",
   "start": 137.699,
   "end": 140.299
  },
  {
   "scene": "s04",
   "text": "어학원도 같은 기준이 적용됩니다.",
   "start": 140.299,
   "end": 142.519
  },
  {
   "scene": "s05",
   "text": "이게 주정부 문서에만 있는 얘기가 아닙니다.",
   "start": 144.227,
   "end": 146.847
  },
  {
   "scene": "s05",
   "text": "밴쿠버 교육청 신규 등록 안내에도 똑같이 나와 있어요.",
   "start": 147.627,
   "end": 151.027
  },
  {
   "scene": "s05",
   "text": "학생비자 1년 이상이고 영어 과정을 듣는 부모의",
   "start": 151.727,
   "end": 155.067
  },
  {
   "scene": "s05",
   "text": "자녀가 학비 없이 다닐 수 있느냐는 질문에,",
   "start": 155.067,
   "end": 158.307
  },
  {
   "scene": "s05",
   "text": "이 세 가지 조건을 모두 충족하면",
   "start": 158.307,
   "end": 160.467
  },
  {
   "scene": "s05",
   "text": "된다고 답하고 있습니다.",
   "start": 160.467,
   "end": 161.567
  },
  {
   "scene": "s05",
   "text": "다만 1년이 넘어가면 국제학생 학비를",
   "start": 162.187,
   "end": 165.107
  },
  {
   "scene": "s05",
   "text": "낼 수 있다는 것도 분명히 적혀 있어요.",
   "start": 165.107,
   "end": 167.327
  },
  {
   "scene": "s06",
   "text": "문제는 이 조건부 입학을 실제로",
   "start": 169.113,
   "end": 171.633
  },
  {
   "scene": "s06",
   "text": "내주는 학교가 있느냐였는데요.",
   "start": 171.633,
   "end": 173.693
  },
  {
   "scene": "s06",
   "text": "알렉산더 컬리지가 이번 10월부터 어학원 경로",
   "start": 174.373,
   "end": 177.933
  },
  {
   "scene": "s06",
   "text": "조건부 입학허가를 발급하기 시작했습니다.",
   "start": 177.933,
   "end": 180.273
  },
  {
   "scene": "s06",
   "text": "공인영어성적이 없거나 부족해도,",
   "start": 181.033,
   "end": 183.533
  },
  {
   "scene": "s06",
   "text": "디포짓 5,000달러를 내면 영어 과정",
   "start": 183.533,
   "end": 185.993
  },
  {
   "scene": "s06",
   "text": "이수를 조건으로 한 입학허가서가 나와요.",
   "start": 185.993,
   "end": 188.313
  },
  {
   "scene": "s06",
   "text": "디포짓은 나중에 알렉산더 학비로 쓰이고,",
   "start": 189.013,
   "end": 191.933
  },
  {
   "scene": "s06",
   "text": "어학연수 기간은 최대 1년까지 허용됩니다.",
   "start": 191.933,
   "end": 194.573
  },
  {
   "scene": "s06",
   "text": "지금 바로 연결되는 협약 어학원은 아이엘에스씨, 캐플란,",
   "start": 195.293,
   "end": 199.166
  },
  {
   "scene": "s06",
   "text": "에스지아이씨, 옥스퍼드 인터내셔널 네 곳이고,",
   "start": 199.166,
   "end": 203.093
  },
  {
   "scene": "s06",
   "text": "곧 밴웨스트와 씨씨이엘,",
   "start": 203.093,
   "end": 204.153
  },
  {
   "scene": "s06",
   "text": "브이지씨가 가능합니다.",
   "start": 205.458,
   "end": 206.173
  },
  {
   "scene": "s06",
   "text": "모두 BC 정부 EQA 지정 기관 명단에 있습니다.",
   "start": 206.873,
   "end": 210.553
  },
  {
   "scene": "s06",
   "text": "학교에서도 교육청 확인에 필요한 입학 관련",
   "start": 211.313,
   "end": 214.113
  },
  {
   "scene": "s06",
   "text": "서류를 지원해 준다고 공식 안내했어요.",
   "start": 214.113,
   "end": 216.353
  },
  {
   "scene": "s07",
   "text": "그래서 AA Canada가 추천하는",
   "start": 218.06,
   "end": 220.38
  },
  {
   "scene": "s07",
   "text": "밴쿠버 자녀무상교육 플랜은 두 가지입니다.",
   "start": 220.38,
   "end": 223.02
  },
  {
   "scene": "s07",
   "text": "플랜 A.",
   "start": 223.68,
   "end": 224.3
  },
  {
   "scene": "s07",
   "text": "영어 점수가 있다면,",
   "start": 225.0,
   "end": 226.34
  },
  {
   "scene": "s07",
   "text": "듀오링고 90이나 아이엘츠 5.0부터",
   "start": 226.34,
   "end": 229.54
  },
  {
   "scene": "s07",
   "text": "알렉산더 준학사로 바로 입학하는 방법이에요.",
   "start": 229.54,
   "end": 232.08
  },
  {
   "scene": "s07",
   "text": "학위 과정이니까 처음부터 자녀",
   "start": 232.74,
   "end": 234.86
  },
  {
   "scene": "s07",
   "text": "학비 면제 조건에 들어갑니다.",
   "start": 234.86,
   "end": 236.32
  },
  {
   "scene": "s07",
   "text": "플랜 B.",
   "start": 237.16,
   "end": 237.76
  },
  {
   "scene": "s07",
   "text": "영어 점수가 없다면,",
   "start": 238.4,
   "end": 240.06
  },
  {
   "scene": "s07",
   "text": "알렉산더 조건부 입학허가를 받고 협약",
   "start": 240.06,
   "end": 242.78
  },
  {
   "scene": "s07",
   "text": "어학원에서 어학연수로 시작합니다.",
   "start": 242.78,
   "end": 244.82
  },
  {
   "scene": "s07",
   "text": "어학연수 최대 1년 동안 자녀 무상교육,",
   "start": 245.44,
   "end": 248.58
  },
  {
   "scene": "s07",
   "text": "그다음 준학사로 올라가서 계속 무상교육.",
   "start": 248.58,
   "end": 251.16
  },
  {
   "scene": "s07",
   "text": "부모님은 영어를 준비하고,",
   "start": 251.82,
   "end": 253.52
  },
  {
   "scene": "s07",
   "text": "아이는 처음부터 공립학교에 다니는 구조예요.",
   "start": 253.52,
   "end": 256.26
  },
  {
   "scene": "s07",
   "text": "참고로 밴쿠버 교육청 국제학생 학비는",
   "start": 257.04,
   "end": 259.9
  },
  {
   "scene": "s07",
   "text": "2027-28학년도 기준 1년에 17,000달러,",
   "start": 259.9,
   "end": 264.32
  },
  {
   "scene": "s07",
   "text": "의료보험 1,400달러가 따로 붙습니다.",
   "start": 264.32,
   "end": 266.78
  },
  {
   "scene": "s08",
   "text": "다만 꼭 알아두셔야 할 게 세 가지 있어요.",
   "start": 268.526,
   "end": 271.246
  },
  {
   "scene": "s08",
   "text": "첫째, 부모 학생비자가 1년 이상이어야 합니다.",
   "start": 271.886,
   "end": 275.406
  },
  {
   "scene": "s08",
   "text": "둘째, 어학연수만 따로 하는 건 안 되고,",
   "start": 276.106,
   "end": 279.466
  },
  {
   "scene": "s08",
   "text": "반드시 학위 과정 조건부 입학이 붙어 있어야 해요.",
   "start": 279.466,
   "end": 282.706
  },
  {
   "scene": "s08",
   "text": "어학연수가 1년을 넘으면 그때부터는",
   "start": 283.366,
   "end": 286.166
  },
  {
   "scene": "s08",
   "text": "국제학생 학비 대상이 될 수 있습니다.",
   "start": 286.166,
   "end": 288.186
  },
  {
   "scene": "s08",
   "text": "셋째, 최종 판단은 교육청이 합니다.",
   "start": 289.026,
   "end": 291.746
  },
  {
   "scene": "s08",
   "text": "규정이 있어도 서류를 보고 교육청이 결정하니까,",
   "start": 292.406,
   "end": 295.826
  },
  {
   "scene": "s08",
   "text": "등록 서류를 처음부터 제대로 준비하는 게 중요합니다.",
   "start": 295.826,
   "end": 299.046
  },
  {
   "scene": "s09",
