 ],
 "cues": [
  {
   "scene": "s01",
   "text": "밴쿠버 자녀무상교육,",
   "start": 0.82,
   "end": 2.44
  },
  {
   "scene": "s01",
   "text": "영어 점수가 없으면 못 한다고 생각하셨나요?",
   "start": 2.44,
   "end": 5.02
  },
  {
   "scene": "s01",
   "text": "이제는 영어 점수가 없어도,",
   "start": 5.02,
   "end": 7.06
  },
  {
   "scene": "s01",
   "text": "사설 어학원 어학연수로 시작해서 최대 1년까지",
   "start": 7.06,
   "end": 10.7
  },
  {
   "scene": "s01",
   "text": "아이 학비 면제를 받을 수 있는 길이 있습니다.",
   "start": 10.7,
   "end": 13.12
  },
  {
   "scene": "s01",
   "text": "말로만 하면 믿기 어려우시니까,",
   "start": 13.94,
   "end": 15.88
  },
  {
   "scene": "s01",
   "text": "오늘은 BC 주정부 규정 원문을",
   "start": 15.88,
   "end": 18.54
  },
  {
   "scene": "s01",
   "text": "화면에 띄워 놓고 하나씩 보여드릴게요.",
   "start": 18.54,
   "end": 21.28
  },
  {
   "scene": "s01",
   "text": "안녕하세요, AA Canada입니다.",
   "start": 21.28,
   "end": 23.5
  },
  {
   "scene": "s02",
   "text": "먼저 원리부터 짚고 갈게요.",
   "start": 25.449,
   "end": 27.229
  },
  {
   "scene": "s02",
   "text": "BC주에서 아이가 공립학교를 무료로 다니려면,",
   "start": 27.229,
   "end": 31.049
  },
  {
   "scene": "s02",
   "text": "아이가 거주자로 인정돼야 합니다.",
   "start": 31.049,
   "end": 33.529
  },
  {
   "scene": "s02",
   "text": "시민권자나 영주권자가 아니어도,",
   "start": 33.529,
   "end": 35.789
  },
  {
   "scene": "s02",
   "text": "부모가 일정 조건의 학생비자나 취업비자를",
   "start": 35.789,
   "end": 39.209
  },
  {
   "scene": "s02",
   "text": "갖고 있으면 교육청이 학비를 받지 않아요.",
   "start": 39.209,
   "end": 42.169
  },
  {
   "scene": "s02",
   "text": "이 기준을 정해 둔 게 BC주 교육부의",
   "start": 42.169,
   "end": 45.249
  },
  {
   "scene": "s02",
   "text": "운영 지원금 대상 학생 규정입니다.",
   "start": 45.249,
   "end": 47.769
  },
  {
   "scene": "s02",
   "text": "2011년에 시행되고 2013년에 개정된 뒤,",
   "start": 47.769,
   "end": 51.549
  },
  {
   "scene": "s02",
   "text": "지금도 유효한 규정이에요.",
   "start": 51.549,
   "end": 53.229
  },
  {
   "scene": "s03",
   "text": "부모가 학생일 때 기본 조건은 두 가지입니다.",
   "start": 55.178,
   "end": 58.538
  },
  {
   "scene": "s03",
   "text": "첫째, 1년 이상 학업이 허가된 학생비자.",
   "start": 58.538,
   "end": 61.878
  },
  {
   "scene": "s03",
   "text": "둘째, BC주 공립 대학이나 컬리지의 학위·디플로마 과정,",
   "start": 61.878,
   "end": 66.338
  },
  {
   "scene": "s03",
   "text": "또는 사립이라면 학위 과정에 다니고 있어야 해요.",
   "start": 66.338,
   "end": 70.098
  },
  {
   "scene": "s03",
   "text": "여기서 중요한 단어가 '사립은 학위'입니다.",
   "start": 70.098,
   "end": 72.418
  },
  {
   "scene": "s03",
   "text": "사립 컬리지의 디플로마나",
   "start": 72.418,
   "end": 74.318
  },
  {
   "scene": "s03",
   "text": "수료증 과정은 해당이 안 되고,",
   "start": 74.318,
   "end": 76.838
  },
  {
   "scene": "s03",
   "text": "학위 과정이어야 합니다.",
   "start": 76.838,
   "end": 78.258
  },
  {
   "scene": "s03",
   "text": "그래서 저희가 주목하는 게 사립 컬리지의 준학사,",
   "start": 78.258,
   "end": 81.671
  },
  {
   "scene": "s03",
   "text": "어소시에이트 디그리예요.",
   "start": 81.671,
   "end": 83.298
  },
  {
   "scene": "s04",
   "text": "그럼 영어 점수가 없는 부모님은요?",
   "start": 85.293,
   "end": 87.833
  },
  {
   "scene": "s04",
   "text": "바로 이 부분이 오늘의 핵심입니다.",
   "start": 87.833,
   "end": 90.073
  },
  {
   "scene": "s04",
   "text": "규정 바로 아래에 이런 조항이 있어요.",
   "start": 90.073,
   "end": 92.933
  },
  {
   "scene": "s04",
   "text": "1년 이상 학업이 허가된 부모가,",
   "start": 92.933,
   "end": 95.453
  },
  {
   "scene": "s04",
   "text": "다음 세 가지를 모두 충족하면 됩니다.",
   "start": 95.453,
   "end": 98.633
  },
  {
   "scene": "s04",
   "text": "하나, EQA,",
   "start": 98.633,
   "end": 100.213
  },
  {
   "scene": "s04",
   "text": "그러니까 BC주 교육품질인증을 받은 기관에서",
   "start": 100.213,
   "end": 103.753
  },
  {
   "scene": "s04",
   "text": "최대 1년짜리 영어 과정을 듣고 있을 것.",
   "start": 103.753,
   "end": 107.033
  },
  {
   "scene": "s04",
   "text": "둘, 공립 학위나 디플로마,",
   "start": 107.033,
   "end": 109.273
  },
  {
   "scene": "s04",
   "text": "또는 사립 학위 과정에 입학허가를 받았을 것.",
   "start": 109.273,
   "end": 112.553
  },
  {
   "scene": "s04",
   "text": "셋, 그 입학허가가 영어 과정 수료를",
   "start": 112.553,
   "end": 115.513
  },
  {
   "scene": "s04",
   "text": "조건으로 한 조건부 입학일 것.",
   "start": 115.513,
   "end": 117.933
  },
  {
   "scene": "s04",
   "text": "이 세 가지가 맞으면,",
   "start": 117.933,
   "end": 119.613
  },
  {
   "scene": "s04",
   "text": "부모가 어학연수를 하는 동안에도",
   "start": 119.613,
   "end": 122.173
  },
  {
   "scene": "s04",
   "text": "최대 1년까지 거주자로 봅니다.",
   "start": 122.173,
   "end": 124.413
  },
  {
   "scene": "s04",
   "text": "규정에는 '대학 부설'이라는 제한이 없고,",
   "start": 124.413,
   "end": 127.353
  },
  {
   "scene": "s04",
   "text": "EQA 지정 기관이라고만 되어 있어요.",
   "start": 127.353,
   "end": 129.913
  },
  {
   "scene": "s04",
   "text": "그래서 EQA 인증을 받은 사설",
   "start": 129.913,
   "end": 132.773
  },
  {
   "scene": "s04",
   "text": "어학원도 같은 기준이 적용됩니다.",
   "start": 132.773,
   "end": 134.853
  },
  {
   "scene": "s05",
   "text": "이게 주정부 문서에만 있는 얘기가 아닙니다.",
   "start": 136.704,
   "end": 140.284
  },
  {
   "scene": "s05",
   "text": "밴쿠버 교육청 신규 등록 안내에도 똑같이 나와 있어요.",
   "start": 140.284,
   "end": 143.724
  },
  {
   "scene": "s05",
   "text": "학생비자 1년 이상이고 영어 과정을 듣는 부모의",
   "start": 144.364,
   "end": 147.784
  },
  {
   "scene": "s05",
   "text": "자녀가 학비 없이 다닐 수 있느냐는 질문에,",
   "start": 147.784,
   "end": 150.844
  },
  {
   "scene": "s05",
   "text": "이 세 가지 조건을 모두 충족하면",
   "start": 150.844,
   "end": 153.424
  },
  {
   "scene": "s05",
   "text": "된다고 답하고 있습니다.",
   "start": 153.424,
   "end": 155.164
  },
  {
   "scene": "s05",
   "text": "다만 1년이 넘어가면 국제학생 학비를",
   "start": 155.164,
   "end": 158.144
  },
  {
   "scene": "s05",
   "text": "낼 수 있다는 것도 분명히 적혀 있어요.",
   "start": 158.144,
   "end": 160.744
  },
  {
   "scene": "s06",
   "text": "문제는 이 조건부 입학을 실제로",
   "start": 162.687,
   "end": 164.927
  },
  {
   "scene": "s06",
   "text": "내주는 학교가 있느냐였는데요.",
   "start": 164.927,
   "end": 167.547
  },
  {
   "scene": "s06",
   "text": "알렉산더 컬리지가 이번 10월부터 어학원 경로",
   "start": 167.547,
   "end": 171.307
  },
  {
   "scene": "s06",
   "text": "조건부 입학허가를 발급하기 시작했습니다.",
   "start": 171.307,
   "end": 174.747
  },
  {
   "scene": "s06",
   "text": "공인영어성적이 없거나 부족해도,",
   "start": 174.747,
   "end": 176.992
  },
  {
   "scene": "s06",
   "text": "디포짓 5,000달러를 내면 영어 과정",
   "start": 176.992,
   "end": 180.727
  },
  {
   "scene": "s06",
   "text": "이수를 조건으로 한 입학허가서가 나와요.",
   "start": 180.727,
   "end": 183.2
  },
  {
   "scene": "s06",
   "text": "디포짓은 나중에 알렉산더 학비로 쓰이고,",
   "start": 183.2,
   "end": 187.387
  },
  {
   "scene": "s06",
   "text": "어학연수 기간은 최대 1년까지 허용됩니다.",
   "start": 187.387,
   "end": 190.267
  },
  {
   "scene": "s06",
   "text": "지금 바로 연결되는 협약 어학원은 아이엘에스씨, 캐플란,",
   "start": 190.887,
   "end": 195.087
  },
  {
   "scene": "s06",
   "text": "에스지아이씨, 옥스퍼드 인터내셔널 네 곳이고,",
   "start": 195.087,
   "end": 199.227
  },
  {
   "scene": "s06",
   "text": "곧 밴웨스트와 씨씨이엘,",
   "start": 199.227,
   "end": 200.087
  },
  {
   "scene": "s06",
   "text": "브이지씨가 가능합니다.",
   "start": 201.692,
   "end": 203.027
  },
  {
   "scene": "s06",
   "text": "모두 BC 정부 EQA 지정 기관 명단에 있습니다.",
   "start": 203.027,
   "end": 206.947
  },
  {
   "scene": "s06",
   "text": "학교에서도 교육청 확인에 필요한 입학 관련",
   "start": 206.947,
   "end": 209.687
  },
  {
   "scene": "s06",
   "text": "서류를 지원해 준다고 공식 안내했어요.",
   "start": 209.687,
   "end": 212.047
  },
  {
   "scene": "s07",
   "text": "그래서 AA Canada가 추천하는",
   "start": 213.947,
   "end": 216.447
  },
  {
   "scene": "s07",
   "text": "밴쿠버 자녀무상교육 플랜은 두 가지입니다.",
   "start": 216.447,
   "end": 218.947
  },
  {
   "scene": "s07",
   "text": "플랜 A.",
   "start": 218.947,
   "end": 219.527
  },
  {
   "scene": "s07",
   "text": "영어 점수가 있다면,",
   "start": 219.527,
   "end": 221.047
  },
  {
   "scene": "s07",
   "text": "듀오링고 90이나 아이엘츠 5.0부터",
   "start": 221.047,
   "end": 224.227
  },
  {
   "scene": "s07",
   "text": "알렉산더 준학사로 바로 입학하는 방법이에요.",
   "start": 224.227,
   "end": 227.727
  },
  {
   "scene": "s07",
   "text": "학위 과정이니까 처음부터 자녀",
   "start": 227.727,
   "end": 230.487
  },
  {
   "scene": "s07",
   "text": "학비 면제 조건에 들어갑니다.",
   "start": 230.487,
   "end": 232.827
  },
  {
   "scene": "s07",
   "text": "플랜 B.",
   "start": 232.827,
   "end": 233.387
  },
  {
   "scene": "s07",
   "text": "영어 점수가 없다면,",
   "start": 233.387,
   "end": 234.987
  },
  {
   "scene": "s07",
   "text": "알렉산더 조건부 입학허가를 받고 협약",
   "start": 234.987,
   "end": 238.127
  },
  {
   "scene": "s07",
   "text": "어학원에서 어학연수로 시작합니다.",
   "start": 238.127,
   "end": 241.027
  },
  {
   "scene": "s07",
   "text": "어학연수 최대 1년 동안 자녀 무상교육,",
   "start": 241.027,
   "end": 244.287
  },
  {
   "scene": "s07",
   "text": "그다음 준학사로 올라가서 계속 무상교육.",
   "start": 244.287,
   "end": 247.267
  },
  {
   "scene": "s07",
   "text": "부모님은 영어를 준비하고,",
   "start": 247.267,
   "end": 249.227
  },
  {
   "scene": "s07",
   "text": "아이는 처음부터 공립학교에 다니는 구조예요.",
   "start": 249.227,
   "end": 252.527
  },
  {
   "scene": "s07",
   "text": "참고로 밴쿠버 교육청 국제학생 학비는",
   "start": 252.527,
   "end": 255.707
  },
  {
   "scene": "s07",
   "text": "2027-28학년도 기준 1년에 17,000달러,",
   "start": 255.707,
   "end": 259.747
  },
  {
   "scene": "s07",
   "text": "의료보험 1,400달러가 따로 붙습니다.",
   "start": 259.747,
   "end": 261.627
  },
  {
   "scene": "s08",
   "text": "다만 꼭 알아두셔야 할 게 세 가지 있어요.",
   "start": 263.655,
   "end": 266.695
  },
  {
   "scene": "s08",
   "text": "첫째, 부모 학생비자가 1년 이상이어야 합니다.",
   "start": 266.695,
   "end": 269.835
  },
  {
   "scene": "s08",
   "text": "둘째, 어학연수만 따로 하는 건 안 되고,",
   "start": 269.835,
   "end": 273.035
  },
  {
   "scene": "s08",
   "text": "반드시 학위 과정 조건부 입학이 붙어 있어야 해요.",
   "start": 273.035,
   "end": 276.215
  },
  {
   "scene": "s08",
   "text": "어학연수가 1년을 넘으면 그때부터는",
   "start": 276.215,
   "end": 279.155
  },
  {
   "scene": "s08",
   "text": "국제학생 학비 대상이 될 수 있습니다.",
   "start": 279.155,
   "end": 280.915
  },
  {
   "scene": "s08",
   "text": "셋째, 최종 판단은 교육청이 합니다.",
   "start": 281.575,
   "end": 284.015
  },
  {
   "scene": "s08",
   "text": "규정이 있어도 서류를 보고 교육청이 결정하니까,",
   "start": 284.015,
   "end": 287.835
  },
  {
   "scene": "s08",
   "text": "등록 서류를 처음부터 제대로 준비하는 게 중요합니다.",
   "start": 287.835,
   "end": 291.115
  },
  {
   "scene": "s09",
