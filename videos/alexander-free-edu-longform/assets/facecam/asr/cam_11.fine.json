[
 {
  "start": 2.3,
  "end": 4.3,
  "text": "캐다 학생이 많은 공"
 },
 {
  "start": 4.5,
  "end": 8.0,
  "text": "컬지가 지 않나요? 라고 질문 주시는 분들도 계신데요."
 },
 {
  "start": 8.58,
  "end": 9.88,
  "text": "상원에 따라서는"
 },
 {
  "start": 10.24,
  "end": 12.46,
  "text": "니지가 맞는 분들이 있을 수도 있습니다. 니지가 맞는"
 },
 {
  "start": 12.98,
  "end": 13.54,
  "text": "그래도"
 },
 {
  "start": 13.8,
  "end": 17.6,
  "text": "자 동반하시는 분들은 아무도 아이 케어해야 되기 때문에"
 },
 {
  "start": 18.16,
  "end": 18.88,
  "text": "오오오오오오오오오오"
 },
 {
  "start": 19.24,
  "end": 20.34,
  "text": "분의 학업."
 },
 {
  "start": 20.5,
  "end": 22.08,
  "text": "부담이 너무 크지 않아야 되거든요."
 },
 {
  "start": 22.56,
  "end": 24.74,
  "text": "그리고 이제 이런 알 컬지는"
 },
 {
  "start": 25.04,
  "end": 26.3,
  "text": "일단 클스 가 작."
 },
 {
  "start": 26.48,
  "end": 26.72,
  "text": "5"
 },
 {
  "start": 27.14,
  "end": 29.12,
  "text": "일일 학업 플닝이 가능하고요."
 },
 {
  "start": 29.56,
  "end": 31.9,
  "text": "한국인 담당자가 상주 하고 있어서"
 },
 {
  "start": 32.5,
  "end": 34.66,
  "text": "자 동반한 부님한테는"
 },
 {
  "start": 35.26,
  "end": 36.98,
  "text": "아무도 유한 측면이"
 },
 {
  "start": 37.2,
  "end": 38.6,
  "text": "훨씬 많이 있다고 볼 수 있어요."
 }
]