[
 {
  "start": 0.74,
  "end": 7.42,
  "text": "BC주에는 여교육에 대한 그런 주정부의 정이 있어요."
 },
 {
  "start": 7.76,
  "end": 8.3,
  "text": "그래서"
 },
 {
  "start": 8.62,
  "end": 13.32,
  "text": "동반자가 무교육을 받기 위한 주정부 정을 살면"
 },
 {
  "start": 13.76,
  "end": 14.9,
  "text": "일단 부님이"
 },
 {
  "start": 15.24,
  "end": 18.96,
  "text": "학생비자가 1년 이상의 기간을 가지고 있는"
 },
 {
  "start": 19.54,
  "end": 20.58,
  "text": "있어야 되고요."
 },
 {
  "start": 20.9,
  "end": 21.68,
  "text": "그 다음에"
 },
 {
  "start": 22.02,
  "end": 24.94,
  "text": "공 대학을 다니는 경우에는"
 },
 {
  "start": 25.24,
  "end": 26.58,
  "text": "2년제 이상"
 },
 {
  "start": 26.94,
  "end": 29.08,
  "text": "디나 학위과정을 공부해야 합니다."
 },
 {
  "start": 29.58,
  "end": 31.28,
  "text": "아니면 사인 경우에는"
 },
 {
  "start": 31.88,
  "end": 32.18,
  "text": "사"
 },
 {
  "start": 33.68,
  "end": 34.48,
  "text": "그 컬."
 },
 {
  "start": 35.64,
  "end": 39.22,
  "text": "아니면 사인 경우에는 학위 과정을 공부 해야 돼요."
 },
 {
  "start": 39.74,
  "end": 42.0,
  "text": "그러면 무교육이 적용 수 있어요."
 },
 {
  "start": 42.44,
  "end": 43.38,
  "text": "그래서 사은"
 },
 {
  "start": 43.74,
  "end": 44.98,
  "text": "디마는 안고"
 },
 {
  "start": 45.36,
  "end": 47.7,
  "text": "하기 과정은 된다 이렇게 보시면 됩니다"
 },
 {
  "start": 48.06,
  "end": 49.84,
  "text": "그 Degree 과정을 말하는 거예요."
 },
 {
  "start": 51.04,
  "end": 53.92,
  "text": "기준은 국이 사이가 아니고"
 },
 {
  "start": 54.46,
  "end": 57.44,
  "text": "어떤 과정을 공부하고 보시면 돼요."
 }
]