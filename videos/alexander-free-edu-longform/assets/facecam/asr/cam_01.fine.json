[
 {
  "start": 2.64,
  "end": 7.74,
  "text": "여교육을 알아시는 분들은 이런 얘기 들어 적이 있으실 거예요."
 },
 {
  "start": 8.6,
  "end": 10.72,
  "text": "무교육이 되기 위해서는"
 },
 {
  "start": 11.4,
  "end": 11.68,
  "text": "사"
 },
 {
  "start": 12.38,
  "end": 13.18,
  "text": "대학 말고"
 },
 {
  "start": 13.44,
  "end": 14.62,
  "text": "국대학을 가야 된다."
 },
 {
  "start": 15.1,
  "end": 15.54,
  "text": "그래서"
 },
 {
  "start": 15.84,
  "end": 21.06,
  "text": "공대학의 디마 과정을 가야지만 자교육이 적용 수 있고"
 },
 {
  "start": 21.48,
  "end": 23.68,
  "text": "뭐 이런 것들도 교육청들마다 다다."
 },
 {
  "start": 24.1,
  "end": 25.4,
  "text": "이렇게 얘기하는"
 },
 {
  "start": 25.58,
  "end": 26.54,
  "text": "분들도 있라고요."
 },
 {
  "start": 27.16,
  "end": 29.94,
  "text": "제가 오늘 그런 부분을 좀 정확하게 어고 합니다."
 },
 {
  "start": 30.48,
  "end": 32.04,
  "text": "일반적으로 국~"
 },
 {
  "start": 32.96,
  "end": 34.74,
  "text": "컬지가"
 },
 {
  "start": 35.12,
  "end": 36.52,
  "text": "사지에 비해서"
 },
 {
  "start": 36.88,
  "end": 40.22,
  "text": "입학도 좀 더 까다고 학도 비싸고 이런 부분이 있거든요."
 },
 {
  "start": 40.62,
  "end": 42.56,
  "text": "그래서 사으로 가 참 좋을데."
 },
 {
  "start": 43.3,
  "end": 45.04,
  "text": "많은 분들이"
 },
 {
  "start": 45.52,
  "end": 45.92,
  "text": "어..."
 },
 {
  "start": 46.2,
  "end": 47.78,
  "text": "그런 부분에 명확하게"
 },
 {
  "start": 48.3,
  "end": 50.38,
  "text": "는 부들이 있어가지고"
 },
 {
  "start": 50.98,
  "end": 51.22,
  "text": "아"
 },
 {
  "start": 52.16,
  "end": 55.08,
  "text": "확실하게 그 부분을 말씀드고 합니다."
 }
]