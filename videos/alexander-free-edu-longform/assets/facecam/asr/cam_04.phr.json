[
 {
  "start": 0.78,
  "end": 2.22,
  "text": "자 무 교육을 할 때"
 },
 {
  "start": 2.6,
  "end": 5.72,
  "text": "부님 입장에서 가장 큰 부담이 되는 것은"
 },
 {
  "start": 6.44,
  "end": 10.12,
  "text": "학업이에요. 공부이 너무 많으면 아이 케어하는데"
 },
 {
  "start": 10.52,
  "end": 11.48,
  "text": "부담이 되니까요."
 },
 {
  "start": 12.04,
  "end": 14.98,
  "text": "그런데 이 프로그램을 하는 경우에"
 },
 {
  "start": 15.32,
  "end": 16.88,
  "text": "가장 큰 장점은"
 },
 {
  "start": 17.2,
  "end": 18.5,
  "text": "한 학기의 세"
 },
 {
  "start": 19.18,
  "end": 24.38,
  "text": "구학만 들어도 된다는 거예요. 그러니까 일주일에 9시 들어도 됩니다."
 },
 {
  "start": 25.22,
  "end": 25.66,
  "text": "그래서"
 },
 {
  "start": 26.0,
  "end": 29.22,
  "text": "그리고 이제 한 학기에 약 14주 정도 리는데요."
 },
 {
  "start": 29.62,
  "end": 30.92,
  "text": "강의는"
 },
 {
  "start": 31.34,
  "end": 32.08,
  "text": "추당"
 },
 {
  "start": 32.58,
  "end": 33.24,
  "text": "한~"
 },
 {
  "start": 44.08,
  "end": 47.16,
  "text": "강의는 주당 9시간 정도로 보도 됩니다."
 },
 {
  "start": 48.08,
  "end": 50.94,
  "text": "그리고 여학 때는 부님이  수 있구요."
 },
 {
  "start": 51.98,
  "end": 54.58,
  "text": "보통 편입생들은"
 },
 {
  "start": 55.1,
  "end": 57.34,
  "text": "주 학기당한 5과 정도 듣는데요."
 },
 {
  "start": 57.78,
  "end": 58.82,
  "text": "부님 학생들은"
 },
 {
  "start": 59.18,
  "end": 62.92,
  "text": "3과씩만 들어도 풀타임 학생이 유지가 되기 때문에"
 },
 {
  "start": 63.32,
  "end": 65.36,
  "text": "학업 부담을 많이 줄일 수가 있어요."
 }
]