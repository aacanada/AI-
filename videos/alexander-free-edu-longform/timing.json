    {
     "text": "아이 케어가 우선인",
     "start": 244.12,
     "end": 245.76,
     "speech_end": 245.76
    },
    {
     "text": "부모님께 맞는 환경이에요",
     "start": 245.76,
     "end": 247.78,
     "speech_end": 247.42
    }
   ]
  },
  {
