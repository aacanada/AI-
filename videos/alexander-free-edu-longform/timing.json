 "scenes": [
  {
   "id": "s01-hook",
   "start": 0.0,
   "duration": 15.36,
   "audio_end": 14.86,
   "captions": [
    {
     "text": "밴쿠버 자녀무상교육,",
     "start": 0.3,
     "end": 1.92,
     "speech_end": 1.8
    },
    {
     "text": "알아보시다가 이런 말 들어 보셨죠?",
     "start": 1.92,
     "end": 4.52,
     "speech_end": 4.1
    },
    {
     "text": "사립 컬리지는 교육청마다",
     "start": 4.52,
     "end": 6.56,
     "speech_end": 6.56
    },
    {
     "text": "될 수도 있고, 안 될 수도 있다",
     "start": 6.56,
     "end": 8.8,
     "speech_end": 8.36
    },
    {
     "text": "그래서 다들 공립만 찾으세요",
     "start": 8.8,
     "end": 11.32,
     "speech_end": 10.92
    },
    {
     "text": "그런데 기준을 정확히 보면",
     "start": 11.32,
     "end": 13.36,
     "speech_end": 13.24
    },
    {
     "text": "이야기가 완전히 달라집니다",
     "start": 13.36,
     "end": 15.36,
     "speech_end": 14.86
    }
   ]
  },
  {
   "id": "s02-rule",
   "start": 15.36,
   "duration": 25.262,
   "audio_end": 40.622,
   "captions": [
    {
     "text": "BC주 교육부 기준은 이렇습니다",
     "start": 15.81,
     "end": 18.53,
     "speech_end": 18.07
    },
    {
     "text": "부모님의 학생비자가 1년 이상이고",
     "start": 18.53,
     "end": 21.383,
     "speech_end": 21.31
    },
    {
     "text": "공립학교라면 학위나 디플로마 과정",
     "start": 21.383,
     "end": 24.73,
     "speech_end": 24.15
    },
    {
     "text": "사립학교라면 학위 과정에",
     "start": 24.73,
     "end": 26.61,
     "speech_end": 26.61
    },
    {
     "text": "다니고 있을 것",
     "start": 26.61,
     "end": 28.077,
     "speech_end": 27.763
    },
    {
     "text": "즉, 사립 컬리지의 디플로마 과정은",
     "start": 28.077,
     "end": 30.53,
     "speech_end": 30.53
    },
    {
     "text": "해당이 안 되지만",
     "start": 30.53,
     "end": 32.0,
     "speech_end": 31.43
    },
    {
     "text": "사립학교라도 학위 과정이라면",
     "start": 32.0,
     "end": 34.17,
     "speech_end": 34.17
    },
    {
     "text": "자녀무상교육 대상이라는 거예요",
     "start": 34.17,
     "end": 36.89,
     "speech_end": 36.203
    },
    {
     "text": "기준은 공립이냐 사립이냐가 아니라",
     "start": 36.89,
     "end": 39.29,
     "speech_end": 39.29
    },
    {
     "text": "어떤 과정이냐입니다",
     "start": 39.29,
     "end": 40.622,
     "speech_end": 40.622
    }
   ]
  },
  {
   "id": "s03-degree",
   "start": 40.622,
   "duration": 19.588,
   "audio_end": 59.2,
   "captions": [
    {
     "text": "알렉산더 컬리지의 준학사",
     "start": 41.072,
     "end": 43.9,
     "speech_end": 43.9
    },
    {
     "text": "Associate of Arts와 Associate of Science는",
     "start": 43.9,
     "end": 48.14,
     "speech_end": 47.76
    },
    {
     "text": "BC주가 승인한 학위 과정입니다",
     "start": 48.14,
     "end": 50.66,
     "speech_end": 50.28
    },
    {
     "text": "밴쿠버 다운타운과 버나비에 캠퍼스가 있고요",
     "start": 50.66,
     "end": 54.26,
     "speech_end": 53.68
    },
    {
     "text": "사립 컬리지 중에서도",
     "start": 54.26,
     "end": 55.94,
     "speech_end": 55.56
    },
    {
     "text": "이 조건에 정확히 들어맞는",
     "start": 55.94,
     "end": 57.78,
     "speech_end": 57.78
    },
    {
     "text": "몇 안 되는 선택지예요",
     "start": 57.78,
     "end": 60.21,
     "speech_end": 59.2
    }
   ]
  },
  {
   "id": "s04-load",
   "start": 60.21,
   "duration": 32.31,
   "audio_end": 91.977,
   "captions": [
    {
     "text": "부모님들이 가장 걱정하시는 건 공부량이죠",
     "start": 60.66,
     "end": 63.676,
     "speech_end": 63.56
    },
    {
     "text": "알렉산더 컬리지는 한 학기에 세 과목",
     "start": 63.676,
     "end": 67.22,
     "speech_end": 67.02
    },
    {
     "text": "9학점만 들어도 풀타임입니다",
     "start": 67.22,
     "end": 69.94,
     "speech_end": 69.6
    },
    {
     "text": "한 학기는 약 14주이고",
     "start": 69.94,
     "end": 72.51,
     "speech_end": 72.305
    },
    {
     "text": "세 과목 기준으로 강의 시간은",
     "start": 72.51,
     "end": 75.15,
     "speech_end": 74.61
    },
    {
     "text": "주 4~6시간대부터 짤 수 있어요",
     "start": 75.15,
     "end": 79.87,
     "speech_end": 79.303
    },
    {
     "text": "여름 학기는 쉬셔도 됩니다",
     "start": 79.87,
     "end": 82.19,
     "speech_end": 81.69
    },
    {
     "text": "편입을 준비하는 학생들은",
     "start": 82.19,
     "end": 84.23,
     "speech_end": 84.07
    },
    {
     "text": "5과목씩 바쁘게 듣지만",
     "start": 84.23,
     "end": 86.35,
     "speech_end": 85.89
    },
    {
     "text": "자녀무상교육을 하시는 부모님들은",
     "start": 86.35,
     "end": 88.81,
     "speech_end": 88.6
    },
    {
     "text": "세 과목씩 꾸준히 이어가시는 경우가",
     "start": 88.81,
     "end": 91.17,
     "speech_end": 91.11
    },
    {
     "text": "대부분이에요",
     "start": 91.17,
     "end": 92.52,
     "speech_end": 91.977
    }
   ]
  },
  {
   "id": "s05-online",
   "start": 92.52,
   "duration": 19.75,
   "audio_end": 112.27,
   "captions": [
    {
     "text": "다운타운까지 통학이 부담되셔도 괜찮습니다",
     "start": 92.97,
     "end": 96.53,
     "speech_end": 96.15
    },
    {
     "text": "온라인으로 개설된 과목은",
     "start": 96.53,
     "end": 98.81,
     "speech_end": 98.23
    },
    {
     "text": "라이브 온라인으로 들으실 수 있고",
     "start": 98.81,
     "end": 101.13,
     "speech_end": 100.89
    },
    {
     "text": "녹화 강의가 아니라 실시간 수업이라서",
     "start": 101.13,
     "end": 104.13,
     "speech_end": 104.057
    },
    {
     "text": "학점도 똑같이 인정돼요",
     "start": 104.13,
     "end": 106.36,
     "speech_end": 105.79
    },
    {
     "text": "아이 학교 보내고, 집에서 수업 듣고",
     "start": 106.36,
     "end": 109.04,
     "speech_end": 108.86
    },
    {
     "text": "끝나면 픽업",
     "start": 109.04,
     "end": 110.24,
     "speech_end": 109.86
    },
    {
     "text": "이런 하루가 가능해집니다",
     "start": 110.24,
     "end": 112.27,
     "speech_end": 112.27
    }
   ]
  },
  {
   "id": "s06-english",
   "start": 112.27,
   "duration": 28.53,
   "audio_end": 140.217,
   "captions": [
    {
     "text": "영어가 걱정되시죠",
     "start": 112.72,
     "end": 114.56,
     "speech_end": 113.98
    },
