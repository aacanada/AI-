   "start": 246.533,
   "speech_end": 278.7,
   "captions": [
    {
     "text": "학비는 학점당 660달러인데요",
     "start": 246.707,
     "speech_end": 250.187,
     "end": 250.647
    },
    {
     "text": "한 학기 세 과목 기준으로 하면은",
     "start": 250.647,
     "speech_end": 253.387,
     "end": 253.387
    },
    {
     "text": "한 학기에 약 5,940달러",
     "start": 253.387,
     "speech_end": 255.887,
     "end": 256.067
    },
    {
     "text": "이게 1년 3학기 기준으로 보면",
     "start": 256.067,
     "speech_end": 258.927,
     "end": 258.927
    },
    {
     "text": "대략 18,000달러 수준인 거예요",
     "start": 258.927,
     "speech_end": 262.287,
     "end": 262.38
    },
    {
     "text": "아이를 조기유학생으로 보내면",
     "start": 262.38,
     "speech_end": 264.12,
     "end": 264.12
    },
    {
     "text": "18,000달러에서 20,000달러 정도 하거든요",
     "start": 264.12,
     "speech_end": 267.94,
     "end": 268.32
    },
    {
     "text": "아이 한 명당이요",
     "start": 268.32,
     "speech_end": 269.22,
     "end": 269.7
    },
    {
     "text": "그러니까 부모님이 18,000달러를 내고",
     "start": 269.7,
     "speech_end": 272.7,
     "end": 272.7
    },
    {
     "text": "자녀가 2명, 3명이 무상교육을 할 수 있으니까",
     "start": 272.7,
     "speech_end": 275.6,
     "end": 275.6
    },
    {
     "text": "메리트가 있다고 할 수 있겠죠",
