   "speech_end": 313.567,
   "captions": [
    {
     "text": "이 준학사 과정을 졸업을 하면은",
     "start": 278.987,
     "speech_end": 281.127,
     "end": 281.127
    },
    {
     "text": "졸업 후에 최대 3년의 PGWP",
     "start": 281.127,
     "speech_end": 283.647,
     "end": 283.647
    },
    {
     "text": "취업비자를 받을 수 있는데요",
     "start": 283.647,
     "speech_end": 286.807,
     "end": 287.207
    },
    {
     "text": "전공이 여러 가지 종류가 있는데",
     "start": 287.207,
     "speech_end": 289.267,
     "end": 289.407
    },
    {
     "text": "어떤 준학사 학위를 했느냐에 따라서",
     "start": 289.407,
     "speech_end": 292.007,
     "end": 292.007
    },
    {
     "text": "취업비자가 가능하기도 합니다",
     "start": 292.007,
     "speech_end": 294.947,
     "end": 295.227
    },
    {
     "text": "그래서 보통 심리학, 사이언스",
     "start": 295.227,
     "speech_end": 299.167,
     "end": 299.167
    },
    {
     "text": "컴퓨터공학, 수학 이런 것들의",
     "start": 299.167,
     "speech_end": 302.587,
     "end": 302.887
    },
    {
     "text": "Associate Degree를 하면",
     "start": 302.887,
     "speech_end": 305.347,
     "end": 305.627
    },
    {
     "text": "졸업 후에 3년의 취업비자를 받을 수 있어요",
     "start": 305.627,
     "speech_end": 308.827,
     "end": 309.033
    },
    {
     "text": "물론 1년 정도만 다니고",
     "start": 309.033,
     "speech_end": 310.793,
     "end": 310.793
    },
    {
     "text": "한국 돌아가셔도 상관없습니다",
     "start": 310.793,
     "speech_end": 313.253,
     "end": 313.717
    }
   ],
   "align_ratio": 1.0,
   "duration": 34.867
  },
  {
   "id": "s09-check",
   "start": 313.767,
   "speech_end": 359.0,
   "captions": [
    {
     "text": "주의하실 점은요",
     "start": 313.92,
     "speech_end": 315.28,
     "end": 315.5
    },
    {
     "text": "PGWP는 전공에 대한 제한이 생겼어요",
     "start": 315.5,
     "speech_end": 318.667,
     "end": 318.667
    },
    {
     "text": "그래서 방금 말씀드린 것처럼",
     "start": 318.667,
     "speech_end": 320.827,
     "end": 321.147
    },
    {
     "text": "내가 전공 분야를 어떤 걸로 하느냐에 따라서",
     "start": 321.147,
     "speech_end": 323.787,
     "end": 323.787
    },
    {
     "text": "졸업 후 취업비자가 가능할 수도 있고",
     "start": 323.787,
     "speech_end": 326.587,
     "end": 326.587
    },
    {
     "text": "안 될 수도 있고 그렇습니다",
     "start": 326.587,
     "speech_end": 328.707,
     "end": 328.887
    },
    {
     "text": "그리고 PGWP를 신청하기 위해서",
     "start": 328.887,
     "speech_end": 330.907,
     "end": 330.907
    },
    {
     "text": "영어 점수 요건이 있으니까",
     "start": 330.907,
     "speech_end": 332.627,
     "end": 332.627
    },
    {
     "text": "이것도 준비를 해야 되겠죠",
     "start": 332.627,
     "speech_end": 334.267,
     "end": 334.393
    },
    {
     "text": "두 번째는 배우자 오픈워크퍼밋인데요",
     "start": 334.393,
     "speech_end": 337.053,
     "end": 337.293
    },
    {
     "text": "예전엔 가능했었어요 그런데",
     "start": 337.293,
     "speech_end": 339.333,
     "end": 339.633
    },
    {
     "text": "2025년 1월부터는",
     "start": 339.633,
     "speech_end": 341.273,
     "end": 341.273
    },
    {
     "text": "보통 석사과정이거나 박사과정 공부하는 경우에만",
     "start": 341.273,
     "speech_end": 345.353,
     "end": 345.353
    },
    {
     "text": "배우자 오픈워크퍼밋이 나오고 있습니다",
     "start": 345.353,
     "speech_end": 348.813,
     "end": 348.987
    },
    {
     "text": "그리고 자녀 교육청 등록은",
     "start": 348.987,
     "speech_end": 350.447,
     "end": 350.447
    },
    {
     "text": "거주하는 교육청마다",
     "start": 350.447,
     "speech_end": 352.107,
     "end": 352.107
    },
    {
     "text": "서류가 조금씩 다를 수 있어서",
     "start": 352.107,
     "speech_end": 354.747,
     "end": 354.747
    },
    {
     "text": "그거는 AA캐나다에서 준비하는 과정에서 안내드리도록 할게요",
     "start": 354.747,
     "speech_end": 358.68,
     "end": 359.15
    }
   ],
   "align_ratio": 1.0,
   "duration": 45.433
  },
  {
   "id": "s10-compare",
   "start": 359.2,
   "speech_end": 394.2,
   "captions": [
    {
     "text": "캐나다 학생이 많은 공립 컬리지가",
     "start": 359.307,
     "speech_end": 361.647,
     "end": 361.647
    },
    {
     "text": "낫지 않나요? 라고",
     "start": 361.647,
     "speech_end": 362.667,
     "end": 362.667
    },
    {
     "text": "질문 주시는 분들도 계신데요",
     "start": 362.667,
     "speech_end": 365.107,
     "end": 365.567
    },
    {
     "text": "상황에 따라서는 공립 컬리지가",
     "start": 365.567,
     "speech_end": 367.607,
     "end": 367.607
    },
    {
     "text": "맞는 분들이 있을 수도 있습니다",
     "start": 367.607,
     "speech_end": 369.527,
     "end": 369.987
    },
    {
     "text": "그래도 자녀 동반하시는 분들은",
     "start": 369.987,
     "speech_end": 372.167,
     "end": 372.167
    },
    {
     "text": "아무래도 아이 케어를 해야 되기 때문에",
     "start": 372.167,
     "speech_end": 374.687,
     "end": 374.927
    },
    {
     "text": "부모님의 학업 부담이",
     "start": 374.927,
     "speech_end": 375.927,
     "end": 375.927
    },
    {
     "text": "너무 크지 않아야 되거든요",
     "start": 375.927,
     "speech_end": 377.907,
     "end": 378.247
    },
    {
     "text": "그리고 이제 이런 알렉산더 컬리지는",
     "start": 378.247,
     "speech_end": 380.167,
     "end": 380.167
    },
    {
     "text": "일단 클래스 사이즈가 작고",
     "start": 380.167,
     "speech_end": 382.527,
     "end": 382.827
    },
    {
     "text": "1:1 학업 플래닝이 가능하고요",
     "start": 382.827,
     "speech_end": 384.987,
     "end": 385.347
    },
    {
     "text": "한국인 담당자가 상주하고 있어서",
     "start": 385.347,
     "speech_end": 387.707,
     "end": 387.82
    },
    {
     "text": "자녀 동반한 부모님한테는",
     "start": 387.82,
     "speech_end": 389.34,
     "end": 389.34
    },
    {
     "text": "아무래도 유리한 측면이",
     "start": 389.34,
     "speech_end": 391.54,
     "end": 391.54
    },
    {
     "text": "훨씬 많이 있다고 볼 수 있어요",
     "start": 391.54,
     "speech_end": 394.04,
     "end": 394.35
    }
   ],
   "align_ratio": 1.0,
   "duration": 35.2
  },
  {
   "id": "s11-cta",
   "start": 394.4,
   "speech_end": 416.633,
   "captions": [
    {
     "text": "공립이고 사립이고 간에",
     "start": 394.54,
     "speech_end": 396.08,
     "end": 396.08
    },
    {
     "text": "자녀무상교육은 가능할 수 있습니다",
     "start": 396.08,
     "speech_end": 399.36,
     "end": 399.76
    },
    {
     "text": "공립, 사립의 문제가 아니라",
     "start": 399.76,
     "speech_end": 400.94,
     "end": 400.94
    },
    {
     "text": "부모님이 어떤 프로그램을 공부하느냐에 따라서",
     "start": 400.94,
     "speech_end": 403.92,
     "end": 403.92
    },
    {
     "text": "달라지는 거예요",
     "start": 403.92,
     "speech_end": 405.36,
     "end": 405.527
    },
    {
     "text": "그래서 가급적이면 자녀 케어 부담도 줄이고",
     "start": 405.527,
     "speech_end": 409.247,
     "end": 409.447
    },
    {
     "text": "학비 부담도 줄일 수 있는",
     "start": 409.447,
     "speech_end": 411.667,
     "end": 411.887
    },
    {
     "text": "이 프로그램에 대해서 궁금하신 점은",
     "start": 411.887,
     "speech_end": 414.947,
     "end": 415.247
    },
    {
     "text": "AA캐나다로 문의 주세요",
     "start": 415.247,
     "speech_end": 416.387,
     "end": 416.783
    }
   ],
   "align_ratio": 1.0,
   "duration": 27.233
  }
 ],
