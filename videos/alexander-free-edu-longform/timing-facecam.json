 "scenes": [
  {
   "id": "s01-hook",
   "start": 0.0,
   "speech_end": 46.367,
   "captions": [
    {
     "text": "자녀무상교육을 알아보시는 분들은",
     "start": 0.06,
     "speech_end": 2.4,
     "end": 2.4
    },
    {
     "text": "이런 얘기 들어 보신 적이 있으실 거예요",
     "start": 2.4,
     "speech_end": 5.24,
     "end": 5.473
    },
    {
     "text": "자녀무상교육이 되기 위해서는",
     "start": 5.473,
     "speech_end": 7.693,
     "end": 7.773
    },
    {
     "text": "사립대학 말고 공립대학을 가야 된다",
     "start": 7.773,
     "speech_end": 10.66,
     "end": 11.02
    },
    {
     "text": "그래서 공립대학의 디플로마 과정을",
     "start": 11.02,
     "speech_end": 13.94,
     "end": 13.94
    },
    {
     "text": "가야지만 자녀무상교육이 적용될 수 있고",
     "start": 13.94,
     "speech_end": 17.08,
     "end": 17.42
    },
    {
     "text": "뭐 이런 것들도 교육청들마다 다 다르다",
     "start": 17.42,
     "speech_end": 19.74,
     "end": 20.02
    },
    {
     "text": "이렇게 얘기하는 분들도 있더라고요",
     "start": 20.02,
     "speech_end": 22.6,
     "end": 22.68
    },
    {
     "text": "제가 오늘 그런 부분을",
     "start": 22.68,
     "speech_end": 23.74,
     "end": 23.74
    },
    {
     "text": "좀 정확하게 짚어 보려고 합니다",
     "start": 23.74,
     "speech_end": 25.58,
     "end": 26.02
    },
    {
     "text": "일반적으로 공립 컬리지가",
     "start": 26.02,
     "speech_end": 28.873,
     "end": 29.293
    },
    {
     "text": "사립 컬리지에 비해서",
     "start": 29.293,
     "speech_end": 30.793,
     "end": 31.033
    },
    {
     "text": "입학도 좀 더 까다롭고",
     "start": 31.033,
     "speech_end": 32.353,
     "end": 32.353
    },
    {
     "text": "학비도 비싸고 이런 부분이 있거든요",
     "start": 32.353,
     "speech_end": 34.513,
     "end": 34.813
    },
    {
     "text": "그래서 사립으로 가면 참 좋을 텐데",
     "start": 34.813,
     "speech_end": 36.813,
     "end": 37.153
    },
    {
     "text": "많은 분들이 그런 부분에 명확하게",
     "start": 37.153,
     "speech_end": 40.14,
     "end": 40.62
    },
    {
     "text": "헷갈리는 부분들이 있어가지고",
     "start": 40.62,
     "speech_end": 42.8,
     "end": 43.167
    },
    {
     "text": "오늘 확실하게 그 부분을",
     "start": 43.167,
     "speech_end": 44.527,
     "end": 44.527
    },
    {
     "text": "말씀드려 보려고 합니다",
     "start": 44.527,
     "speech_end": 46.127,
     "end": 46.517
    }
   ],
   "align_ratio": 1.0,
   "duration": 46.567
  },
  {
   "id": "s02-rule",
   "start": 46.567,
   "speech_end": 96.633,
   "captions": [
    {
     "text": "BC주에는 자녀무상교육에 대한",
     "start": 46.627,
     "speech_end": 50.107,
     "end": 50.107
    },
    {
     "text": "그런 주정부의 규정이 있어요",
     "start": 50.107,
     "speech_end": 53.347,
     "end": 53.647
    },
    {
     "text": "그래서 동반자녀가 무상교육을 받기 위한",
     "start": 53.647,
     "speech_end": 57.127,
     "end": 57.127
    },
    {
     "text": "주정부 규정을 좀 살펴보면",
     "start": 57.127,
     "speech_end": 59.307,
     "end": 59.667
    },
    {
     "text": "일단 부모님이 학생비자가",
     "start": 59.667,
     "speech_end": 62.167,
     "end": 62.167
    },
    {
     "text": "1년 이상의 기간을 가지고 있어야 되고요",
     "start": 62.167,
     "speech_end": 66.547,
     "end": 66.827
    },
    {
     "text": "그 다음에 공립 대학을 다니는 경우에는",
     "start": 66.827,
     "speech_end": 70.367,
     "end": 70.367
    },
    {
     "text": "2년제 이상 디플로마나",
     "start": 70.367,
     "speech_end": 72.347,
     "end": 72.347
    },
    {
     "text": "학위과정을 공부해야 합니다",
     "start": 72.347,
     "speech_end": 75.007,
     "end": 75.327
    },
    {
     "text": "아니면 사립인 경우에는",
     "start": 75.327,
     "speech_end": 76.867,
     "end": 76.867
    },
    {
     "text": "학위 과정을 공부해야 돼요",
     "start": 76.867,
     "speech_end": 78.867,
     "end": 79.427
    },
    {
     "text": "그러면 무상교육이 적용될 수 있어요",
     "start": 79.427,
     "speech_end": 81.847,
     "end": 82.127
    },
    {
     "text": "그래서 사립은 디플로마는 안 되고",
     "start": 82.127,
     "speech_end": 84.467,
     "end": 84.467
    },
    {
     "text": "학위과정은 된다, 이렇게 보시면 됩니다",
     "start": 84.467,
     "speech_end": 87.507,
     "end": 87.747
    },
    {
     "text": "Degree 과정을 말하는 거예요",
     "start": 87.747,
     "speech_end": 89.687,
     "end": 89.813
    },
    {
     "text": "기준은 공립이냐 사립이냐가 아니고",
     "start": 89.813,
     "speech_end": 92.413,
     "end": 92.413
    },
    {
     "text": "어떤 과정을 공부하느냐라고 보시면 돼요",
     "start": 92.413,
     "speech_end": 96.213,
     "end": 96.783
    }
   ],
   "align_ratio": 1.0,
   "duration": 50.266
  },
  {
   "id": "s03-degree",
   "start": 96.833,
   "speech_end": 126.4,
   "captions": [
    {
     "text": "알렉산더 컬리지의 준학사",
     "start": 97.033,
     "speech_end": 99.873,
     "end": 99.927
    },
    {
     "text": "보통 Associate Degree라고 하는데요",
     "start": 99.927,
     "speech_end": 102.427,
     "end": 102.607
    },
    {
     "text": "이 프로그램에 대해서 살펴볼 거예요",
     "start": 102.607,
     "speech_end": 104.827,
     "end": 104.847
    },
    {
     "text": "보통 여기 Associate Degree라고 하는 것은",
     "start": 104.847,
     "speech_end": 108.573,
     "end": 108.933
    },
    {
     "text": "BC 주정부에서 승인한",
     "start": 108.933,
     "speech_end": 110.633,
     "end": 110.633
    },
    {
     "text": "정식 학위 과정입니다",
     "start": 110.633,
     "speech_end": 112.793,
     "end": 113.073
    },
    {
     "text": "이 알렉산더 컬리지는",
     "start": 113.073,
     "speech_end": 114.533,
     "end": 114.853
    },
    {
     "text": "다운타운과 버나비에 있고요",
     "start": 114.853,
     "speech_end": 117.033,
     "end": 117.227
    },
    {
     "text": "그 다음에 사립 중에서도",
     "start": 117.227,
     "speech_end": 118.967,
     "end": 118.967
    },
    {
     "text": "무상교육을 위한 조건이 정확히 맞는",
     "start": 118.967,
     "speech_end": 122.027,
     "end": 122.027
    },
    {
     "text": "몇 안 되는 선택지 중의 하나라고",
     "start": 122.027,
     "speech_end": 124.347,
     "end": 124.347
    },
    {
     "text": "보시면 됩니다",
     "start": 124.347,
     "speech_end": 126.067,
     "end": 126.55
    }
   ],
   "align_ratio": 1.0,
   "duration": 29.767
  },
  {
   "id": "s04-load",
   "start": 126.6,
   "speech_end": 173.7,
   "captions": [
    {
     "text": "자녀무상교육을 할 때",
     "start": 126.6,
     "speech_end": 128.14,
     "end": 128.46
    },
    {
     "text": "부모님 입장에서 가장 큰 부담이 되는 것은",
     "start": 128.46,
     "speech_end": 131.62,
     "end": 131.813
    },
    {
     "text": "학업이에요",
     "start": 131.813,
     "speech_end": 132.693,
     "end": 132.893
    },
    {
     "text": "공부량이 너무 많으면",
     "start": 132.893,
     "speech_end": 134.153,
     "end": 134.153
    },
    {
     "text": "아이 케어하는 데 부담이 되니까요",
     "start": 134.153,
     "speech_end": 136.913,
     "end": 137.413
    },
    {
     "text": "그런데 이 프로그램을 하는 경우에",
     "start": 137.413,
     "speech_end": 140.413,
     "end": 140.753
    },
    {
     "text": "가장 큰 장점은",
     "start": 140.753,
     "speech_end": 142.293,
     "end": 142.553
    },
    {
     "text": "한 학기에 세, 9학점만",
     "start": 142.553,
     "speech_end": 145.253,
     "end": 145.253
    },
    {
     "text": "들어도 된다는 거예요",
     "start": 145.253,
     "speech_end": 147.193,
     "end": 147.353
    },
    {
     "text": "그러니까 일주일에 9시간 들어도 됩니다",
     "start": 147.353,
     "speech_end": 149.813,
     "end": 149.927
    },
    {
     "text": "그리고 한 학기에 약 14주 정도 걸리는데요",
     "start": 149.927,
     "speech_end": 153.207,
     "end": 153.587
    },
    {
     "text": "강의는 주당 9시간 정도로 보시면 됩니다",
     "start": 153.587,
     "speech_end": 156.587,
     "end": 156.867
    },
    {
     "text": "그리고 여름방학 때는",
     "start": 156.867,
     "speech_end": 158.027,
     "end": 158.027
    },
    {
     "text": "부모님이 쉬실 수 있고요",
     "start": 158.027,
     "speech_end": 159.847,
     "end": 159.9
    },
    {
     "text": "보통 편입생들은",
     "start": 159.9,
     "speech_end": 162.4,
     "end": 163.08
    },
    {
     "text": "학기당 5과목 정도 듣는데요",
     "start": 163.08,
     "speech_end": 165.36,
     "end": 165.72
    },
    {
     "text": "부모님 학생들은 3과목씩만 들어도",
     "start": 165.72,
     "speech_end": 168.2,
     "end": 168.2
    },
    {
     "text": "풀타임 학생이 유지가 되기 때문에",
     "start": 168.2,
     "speech_end": 170.56,
     "end": 170.56
    },
    {
     "text": "학업 부담을 많이 줄일 수가 있어요",
     "start": 170.56,
     "speech_end": 173.24,
     "end": 173.85
    }
   ],
   "align_ratio": 1.0,
   "duration": 47.3
  },
  {
   "id": "s05-online",
   "start": 173.9,
   "speech_end": 208.667,
   "captions": [
    {
     "text": "또 다른 특징은요",
     "start": 173.96,
     "speech_end": 175.44,
     "end": 175.86
    },
    {
     "text": "라이브 온라인 수업으로",
     "start": 175.86,
     "speech_end": 177.76,
     "end": 177.76
    },
    {
     "text": "수강을 할 수 있다는 점이에요",
     "start": 177.76,
     "speech_end": 180.24,
     "end": 180.74
    },
    {
     "text": "그래서 거주하는 지역이 다운타운하고 멀어서",
     "start": 180.74,
     "speech_end": 184.36,
     "end": 184.36
    },
    {
     "text": "통학이 부담된다고 하더라도",
     "start": 184.36,
     "speech_end": 186.38,
     "end": 186.38
    },
    {
     "text": "상관없겠죠",
     "start": 186.38,
     "speech_end": 187.92,
     "end": 188.38
    },
    {
     "text": "온라인 개설 과목인 경우에는",
     "start": 188.38,
     "speech_end": 190.18,
     "end": 190.18
    },
    {
     "text": "라이브로 실시간 수업을 하게 되고요",
     "start": 190.18,
     "speech_end": 193.36,
     "end": 193.82
    },
    {
     "text": "그래서 학점도 100% 동일하게",
     "start": 193.82,
     "speech_end": 196.02,
     "end": 196.02
    },
    {
     "text": "인정을 받을 수 있습니다",
     "start": 196.02,
     "speech_end": 197.52,
     "end": 197.72
    },
    {
     "text": "아침에 아이 학교 등교시키고",
     "start": 197.72,
     "speech_end": 199.6,
     "end": 199.6
    },
    {
     "text": "왔다 갔다 하는 부담 없이",
     "start": 199.6,
     "speech_end": 201.42,
     "end": 201.42
    },
    {
     "text": "집에서 수업을 하고요",
     "start": 201.42,
     "speech_end": 202.66,
     "end": 202.66
    },
    {
     "text": "그 다음에 아이 픽업 나가고",
     "start": 202.66,
     "speech_end": 204.6,
     "end": 204.78
    },
    {
     "text": "이런 하루가 가능하다는 게 장점이에요",
     "start": 204.78,
     "speech_end": 208.32,
     "end": 208.817
    }
   ],
   "align_ratio": 1.0,
   "duration": 34.967
  },
  {
   "id": "s06-english",
   "start": 208.867,
   "speech_end": 246.333,
   "captions": [
    {
     "text": "이런 Associate 과정에 입학을 하려면",
     "start": 209.04,
     "speech_end": 211.88,
     "end": 211.88
    },
    {
     "text": "듀오링고 110점이 필요한데요",
     "start": 211.88,
     "speech_end": 214.407,
     "end": 214.407
    },
    {
     "text": "90점이면 일단",
     "start": 214.407,
     "speech_end": 215.707,
     "end": 215.707
    },
    {
     "text": "조건부 입학을 할 수가 있습니다",
     "start": 215.707,
     "speech_end": 218.147,
     "end": 218.547
    },
    {
     "text": "그래서 English 099 수업이 있는데요",
     "start": 218.547,
     "speech_end": 222.167,
     "end": 222.167
    },
    {
     "text": "그 과정을 들어갈 수 있고",
     "start": 222.167,
     "speech_end": 224.327,
     "end": 224.607
    },
    {
     "text": "전공과목을 두 과목 추가해서",
     "start": 224.607,
     "speech_end": 227.027,
     "end": 227.027
    },
    {
     "text": "세 과목을 만들어서",
     "start": 227.027,
     "speech_end": 229.227,
     "end": 229.447
    },
    {
     "text": "첫 학기부터 풀타임 학생으로",
     "start": 229.447,
     "speech_end": 231.847,
     "end": 231.847
    },
    {
     "text": "학위과정 학생으로 인정을 받을 수가 있어요",
     "start": 231.847,
     "speech_end": 235.007,
     "end": 235.14
    },
    {
     "text": "학교에서 듀오링고 코드를 제공해서",
     "start": 235.14,
     "speech_end": 238.66,
     "end": 239.14
    },
    {
     "text": "부모님이 듀오링고 시험을 보실 수도 있습니다",
     "start": 239.14,
     "speech_end": 242.613,
     "end": 243.033
    },
