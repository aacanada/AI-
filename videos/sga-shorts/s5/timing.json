  {
   "t": 1.8,
   "end": 5.98,
   "text": "SGA는 토론토 북쪽 노스욕 중심가에 있습니다.",
   "off": 0
  },
  {
   "t": 6.506,
   "end": 10.778,
   "text": "지하철 노스욕 센터역이 가까워서 겨울 통학도 편해요.",
   "off": 27
  },
  {
   "t": 11.316,
   "end": 17.446,
   "text": "학교에서 5분에서 10분 거리에 토론토 공립교육청과 가톨릭교육청이 모두 있고,",
   "off": 57
  },
  {
   "t": 17.981,
   "end": 21.185,
   "text": "한국으로 치면 대치동 같은 학군 동네예요.",
   "off": 101
  },
  {
   "t": 21.72,
   "end": 27.386,
   "text": "옆에는 큰 도서관과 쇼핑몰, 푸드코트, 아트센터까지 걸어서 해결됩니다.",
   "off": 125
  },
  {
   "t": 27.915,
   "end": 30.191,
   "text": "카카오톡 canlog로 상담해 보세요.",
   "off": 165
  }
 ],
