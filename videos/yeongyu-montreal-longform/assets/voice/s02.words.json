[{"text": "먼저 영어 유치원 비용 더 정확히 보겠습니다.", "start": 0.022, "end": 3.813}, {"text": "교육부사로에 따르면 2020-22", "start": 3.875, "end": 5.803}, {"text": "2025년 서울 영어 유치원의 월평균 90 균", "start": 5.803, "end": 9.183}, {"text": "월평균 교습비는 140만원입니다.", "start": 9.183, "end": 11.773}, {"text": "교습비에 재료비, 급식비, 차량비까지 더한 금액이에요.", "start": 12.045, "end": 16.619}, {"text": "2021년에는 120만 8천원이었으니 4년 사이에 17% 정도 올랐습니다.", "start": 17.002, "end": 24.221}, {"text": "강남이나 복동 같은 학군지는 한 달에 200만 원대도 흔하구요.", "start": 24.409, "end": 29.563}, {"text": "1년에 계산하면 아이 한 명에 약 1,790만 원 아이가 죽이면 3,580만 원", "start": 29.785, "end": 38.358}, {"text": "세시면 5,300,000원입니다.", "start": 38.384, "end": 41.334}, {"text": "여기에 방과 후 프로그램이나 다른 학원까지 더하면 실제 줄은 더 커집니다.", "start": 41.465, "end": 47.683}]