[{"id": "01-hook", "idx": 1, "start": 0, "duration": 16.22, "voiceAt": 1.2, "voiceDur": 13.82, "rows": [{"t": 1.46, "end": 4.92, "text": "버논 공립학교의 교실에 들어서면, 첫날부터 모든 대화가 영어입니다."}, {"t": 5.26, "end": 10.1, "text": "옆자리에도, 복도에도, 점심시간 식당에도 한국어로 기댈 친구는 거의 없습니다."}, {"t": 10.3, "end": 14.74, "text": "그래서 버논 조기유학은, 출발 전에 무엇을 준비하느냐가 첫 학기를 결정합니다."}], "text": "버논 공립학교의 교실에 들어서면, 첫날부터 모든 대화가 영어입니다.\n옆자리에도, 복도에도, 점심시간 식당에도 한국어로 기댈 친구는 거의 없습니다.\n그래서 버논 조기유학은, 출발 전에 무엇을 준비하느냐가 첫 학기를 결정합니다.", "ct": [1.46, 1.46, 1.74, 1.74, 1.74, 1.74, 1.74, 1.74, 2.34, 2.34, 2.34, 2.34, 2.62, 2.62, 2.62, 2.62, 2.62, 3.32, 3.32, 3.32, 3.32, 3.32, 3.32, 3.8, 3.8, 3.8, 4.08, 4.08, 4.08, 4.08, 4.5, 4.5, 4.5, 4.5, 4.5, 4.5, 4.5, 5.26, 5.26, 5.26, 5.26, 5.26, 5.26, 5.26, 5.98, 5.98, 5.98, 5.98, 5.98, 5.98, 6.82, 6.82, 6.82, 6.82, 6.82, 7.36, 7.36, 7.36, 7.36, 7.36, 8.3, 8.3, 8.3, 8.3, 8.3, 8.76, 8.76, 8.76, 9.08, 9.08, 9.08, 9.08, 9.46, 9.46, 9.46, 9.74, 9.74, 9.74, 9.74, 9.74, 9.74, 10.3, 10.3, 10.3, 10.3, 10.66, 10.66, 10.66, 10.92, 10.92, 10.92, 11.14, 11.14, 11.14, 11.94, 11.94, 11.94, 11.94, 12.28, 12.28, 12.28, 12.54, 12.54, 12.54, 12.54, 12.94, 12.94, 12.94, 12.94, 12.94, 12.94, 12.94, 13.66, 13.66, 13.82, 13.82, 13.82, 13.82, 14.24, 14.24, 14.24, 14.24, 14.24, 14.24, 14.24]}, {"id": "02-english-only", "idx": 2, "start": 16.22, "duration": 16.14, "voiceAt": 0.7, "voiceDur": 14.24, "rows": [{"t": 0.92, "end": 4.3, "text": "버논 공립학교 학생의 95%는 캐나다 현지 학생입니다."}, {"t": 4.86, "end": 9.46, "text": "한국 학생과 아시아계 학생이 많은 밴쿠버나 토론토와는 분위기가 전혀 다릅니다."}, {"t": 10.02, "end": 14.62, "text": "한국 학생 수에 상한이 있어서, 학교마다 한국 학생은 손에 꼽을 정도입니다."}], "text": "버논 공립학교 학생의 95%는 캐나다 현지 학생입니다.\n한국 학생과 아시아계 학생이 많은 밴쿠버나 토론토와는 분위기가 전혀 다릅니다.\n한국 학생 수에 상한이 있어서, 학교마다 한국 학생은 손에 꼽을 정도입니다.", "ct": [0.92, 0.92, 1.24, 1.24, 1.24, 1.24, 1.24, 1.74, 1.74, 1.74, 1.74, 2.16, 2.16, 2.16, 2.16, 2.16, 3.12, 3.12, 3.12, 3.12, 3.52, 3.52, 3.52, 3.76, 3.76, 3.76, 3.76, 3.76, 3.76, 3.76, 4.86, 4.86, 4.86, 5.18, 5.18, 5.18, 5.18, 5.66, 5.66, 5.66, 5.66, 5.66