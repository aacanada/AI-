 "cues": [
  {
   "line": 0,
   "text": "아이 둘 학원비로,",
   "spoken": "아이 둘 학원비로,",
   "start": 0.35,
   "end": 1.732
  },
  {
   "line": 0,
   "text": "캐나다 자녀무상교육이 될까요?",
   "spoken": "캐나다 자녀무상교육이 될까요?",
   "start": 1.778,
   "end": 3.926
  },
  {
   "line": 1,
   "text": "한국에서 사교육 받는 아이 두 명이면,",
   "spoken": "한국에서 사교육 받는 아이 두 명이면,",
   "start": 3.972,
   "end": 6.492
  },
  {
   "line": 1,
   "text": "학원비가 한 달 평균 약 121만 원입니다.",
   "spoken": "학원비가 한 달 평균 약 백이십일만 원입니다.",
   "start": 6.55,
   "end": 9.812
  },
  {
   "line": 2,
   "text": "몬트리올 사립컬리지로 가면 부모 학비는 한 달 약 90만 원대,",
   "spoken": "몬트리올 사립컬리지로 가면 부모 학비는 한 달 약 구십만 원대,",
   "start": 9.882,
   "end": 14.456
  },
  {
   "line": 2,
   "text": "아이 공립학교 학비는 0원이에요.",
   "spoken": "아이 공립학교 학비는 영 원이에요.",
   "start": 14.56,
   "end": 16.929
  },
  {
   "line": 3,
   "text": "게다가 몬트리올 월세는 토론토보다 매달 830달러 저렴합니다.",
   "spoken": "게다가 몬트리올 월세는 토론토보다 매달 팔백삼십 달러 저렴합니다.",
   "start": 16.975,
   "end": 22.153
  },
  {
   "line": 4,
   "text": "이렇게 아낀 돈으로 원어민 1:1 튜터를 붙일 수 있어요.",
   "spoken": "이렇게 아낀 돈으로 원어민 일대일 튜터를 붙일 수 있어요.",
   "start": 22.211,
   "end": 25.706
  },
  {
   "line": 4,
   "text": "시간당 40달러면 일주일에 약 5시간입니다.",
   "spoken": "시간당 사십 달러면 일주일에 약 다섯 시간입니다.",
   "start": 25.776,
   "end": 29.026
  },
  {
   "line": 5,
   "text": "학교에서는 친구들과 영어로 자연스럽게,",
   "spoken": "학교에서는 친구들과 영어로 자연스럽게,",
   "start": 29.061,
   "end": 31.627
  },
  {
   "line": 5,
   "text": "튜터와는 1:1로 체계적으로.",
   "spoken": "튜터와는 일대일로 체계적으로.",
   "start": 31.685,
   "end": 33.821
  },
  {
   "line": 6,
   "text": "학교와 튜터를 함께하면,",
   "spoken": "학교와 튜터를 함께하면,",
   "start": 33.868,
   "end": 35.482
  },
  {
   "line": 6,
   "text": "아이 영어가 빠르게 늘 수 있어요.",
   "spoken": "아이 영어가 빠르게 늘 수 있어요.",
   "start": 35.54,
   "end": 37.56
  },
  {
   "line": 7,
   "text": "우리 가족은 얼마면 될까?",
   "spoken": "우리 가족은 얼마면 될까?",
   "start": 37.595,
   "end": 39.127
  },
  {
