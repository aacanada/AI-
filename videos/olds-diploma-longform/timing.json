    {
     "t": 0.35,
     "text": "첫 번째는 정밀농업 테크고노미 디플로마예요.",
     "end": 4.132000000000001
    },
    {
     "t": 4.232,
     "text": "이름이 어렵죠?",
     "end": 5.501
    },
